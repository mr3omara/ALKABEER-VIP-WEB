# Server Environment
NODE_ENV=development
APP_PORT=4000
APP_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://alkabeer_user:alkabeer_secure_pass@localhost:5432/alkabeer_db?schema=public"

# Authentication & Session
# Secret key used for signing session tokens (must be random and >= 32 chars in production)
SESSION_SECRET="alkabeer_development_session_secret_change_in_production_32chars"
SESSION_COOKIE_NAME="alkabeer_session"
SESSION_EXPIRES_IN_SECONDS=86400
COOKIE_SECURE=false

# Development Seed Admin (Optional: Required only when running prisma:seed for the first time)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@alkabeer.local
SEED_ADMIN_PASSWORD=AdminPass123!@#
SEED_ADMIN_FULLNAME="System Administrator"

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
